{
  "name": "mitgliedschaft-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1",
    "dev:local": "node --import tsx scripts/dev-local.mts",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "npm run build && node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.mts",
    "admin:password": "node scripts/password.mjs",
    "format": "prettier --write app components lib scripts tests *.json *.ts *.md"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "next": "^16.3.6",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
